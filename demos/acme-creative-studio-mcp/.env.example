# ==============================================================================
# Acme Inc. Creative Studio MCP App - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize for your GCP environment:
#   cp .env.example .env
# ==============================================================================

# 1. Google Cloud Platform & Vertex AI Configuration
GCP_PROJECT=truiz-agy-demo
GCP_LOCATION=us-central1
VERTEX_AI_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# 2. Cloud Run Service Configuration
SERVICE_NAME=acme-creative-studio-mcp
PORT=8080
ENABLE_MCP_APP=1
ENABLE_STANDALONE_UI=1
REQUIRE_MCP_AUTH=off
MCP_TENANT_ISOLATION=off

# 3. Multimodal Model Configuration (Gemini Omni & Nano Banana)
GEMINI_OMNI_MODEL=gemini-omni-flash-preview
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
NANO_BANANA_MODEL=gemini-3.1-flash-image-preview

# 4. Google Cloud Storage (GCS) Bucket for Reference Assets & Versioned Content
GCS_CREATIVE_BUCKET=truiz-agy-demo-acme-creative-studio-assets
CREATE_GCS_BUCKET=true

# 5. Gemini Enterprise (Discovery Engine) Integration
GE_APP_ID=acme-creative-studio-ge-app
OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=your-oauth-client-secret
