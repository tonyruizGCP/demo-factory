# Copy as .env file and update the values for your GCP project and Gemini Enterprise app
GOOGLE_GENAI_USE_VERTEXAI=true
GCP_PROJECT=acme-enterprise-demo
GCP_PROJECT_NUMBER=123456789012
GOOGLE_CLOUD_LOCATION=global
DISCOVERY_ENGINE_LOCATION=global
GE_APP_ID=acme_ge_app

# Gemini Enterprise OAuth Token Key (injected into tool_context.state by GE via AUTH_ID)
AUTH_NAME=it_assistant_oauth_token

# Primary / Default Data Store ID (Blueprint compatibility)
DATA_STORE_ID=acme-gdrive-ds_google_drive

# Connected Data Stores & Federated Connectors in Gemini Enterprise
JIRA_DATA_STORE_ID=acme-jira-conn_issue
JIRA_CONNECTOR_COLLECTION=acme-jira-conn
JIRA_CLOUD_ID=00000000-0000-0000-0000-000000000000
JIRA_DEFAULT_PROJECT=SAM1
JIRA_BROWSE_BASE_URL=https://acme-co.atlassian.net/browse

GDRIVE_DATA_STORE_ID=acme-gdrive-ds_google_drive
GNOTEBOOK_DATA_STORE_ID=acme-gnotebook-ds
GMAIL_DATA_STORE_ID=acme-gmail-ds_google_mail
GCAL_DATA_STORE_ID=acme-gcal-ds_google_calendar

GITHUB_ISSUE_DATA_STORE_ID=acme-github-ds_issue
GITHUB_REPO_DATA_STORE_ID=acme-github-ds_repository
GITHUB_PR_DATA_STORE_ID=acme-github-ds_pull_request
GITHUB_CONNECTOR_COLLECTION=acme-github-ds

SF_CASE_DATA_STORE_ID=acme-sf-connector_case
SF_ACCOUNT_DATA_STORE_ID=acme-sf-connector_account
SF_CONNECTOR_COLLECTION=acme-sf-connector
SF_INSTANCE_URL=https://acme-co-dev-ed.develop.my.salesforce.com
