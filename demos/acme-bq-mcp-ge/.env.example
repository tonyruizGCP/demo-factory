# ==============================================================================
# Acme BigQuery MCP & Gemini Enterprise Demo Configuration Template
# ==============================================================================

# Google Cloud Project Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
BQ_LOCATION=US

# BigQuery Dataset Configuration
BQ_DATASET_ID=acme_media_intelligence

# Gemini Enterprise App Configuration
GE_LOCATION=global
GE_APP_ID=acme-media-intelligence-app
GE_DATASTORE_ID=acme-bq-mcp-datastore

# MCP Server Configuration
# Option 1: Google Managed Remote BigQuery MCP Server
BQ_MCP_SERVER_URL=https://bigquery.googleapis.com/mcp

# Option 2: Custom Asynchronous Cloud Run MCP Proxy
CUSTOM_MCP_SERVER_URL=https://acme-async-bq-mcp-xxxxx.us-central1.run.app/mcp

# OAuth 2.0 Credentials for Gemini Enterprise Custom MCP Connector
CUSTOM_MCP_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
CUSTOM_MCP_CLIENT_SECRET=your-oauth-client-secret
