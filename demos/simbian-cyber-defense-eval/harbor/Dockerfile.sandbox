# Harbor Hardened Container Sandbox for Cyber Defense Threat Hunting Evaluations
FROM python:3.11-slim

LABEL maintainer="Google Cloud CE Team"
LABEL benchmark="Simbian Cyber Defense Benchmark"
LABEL framework="Harbor / BenchHub"

# Security: Create non-privileged runner user
RUN groupadd -r harbor && useradd -r -g harbor harbor

WORKDIR /workspace

# Install core evaluation and threat hunting libraries
RUN pip install --no-cache-dir \
    pydantic>=2.0.0 \
    pandas>=2.0.0 \
    duckdb>=0.9.0 \
    tabulate>=0.9.0

# Copy runner scripts
COPY . /workspace/

# Security: Read-only files with isolated non-root user
USER harbor

# Block outbound network by default (Harbor egress policy)
ENV PYTHONUNBUFFERED=1
ENV HARBOR_SANDBOX_EGRESS_BLOCKED=1

CMD ["python", "-m", "harbor.verifier"]
