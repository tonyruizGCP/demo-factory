# Google Cloud / Vertex AI Project Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Google AI Studio API Key (Optional alternative to Vertex AI)
GEMINI_API_KEY=your-gemini-api-key

# Harbor Framework Sandbox Configuration
HARBOR_SANDBOX_MODE=local-isolated
HARBOR_TIMEOUT_SECONDS=120
HARBOR_MEMORY_LIMIT_MB=2048
